{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "allow-send-to-ghost-engine",
    "allow-get-system-status",
    "allow-set-hardware-acceleration-preference",
    "allow-get-desktop-timezone",
    "allow-secure-store-upsert",
    "allow-secure-store-get",
    "allow-secure-store-list",
    "allow-secure-store-remove",
    "allow-offline-vault-get-key",
    "allow-offline-vault-set-key",
    "allow-set-stay-minimized",
    "allow-tray-open",
    "allow-tray-navigate",
    "allow-tray-dismiss",
    "allow-tray-exit",
    "allow-vault-key-set",
    "allow-vault-key-get",
    "allow-vault-key-remove",
    "allow-start-discord-rpc",
    "allow-stop-discord-rpc",
    "allow-install-linux-deb-update",
    "allow-prepare-linux-deb-update",
    "allow-notify-link-expiry",
    "allow-clear-link-expiry-notifications",
    "allow-watcher-insert-log",
    "allow-watcher-get-logs",
    "allow-watcher-clear-logs",
    "allow-establish-secure-link",
    "allow-anchor-link",
    "allow-get-link-expiry",
    "allow-set-badge-count"
  ]
}
