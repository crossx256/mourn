# Source, scripts and verified license bytes must not change on Windows checkout.
* text=auto eol=lf
*.woff2 binary
/public/fonts/opendyslexic/OFL.txt text eol=lf
/LICENSE text eol=lf

# Lock commitments use canonical UTF-8/LF bytes on every platform.
/bun.lock text eol=lf
/src-tauri/Cargo.lock text eol=lf
/src-capacitor/bun.lock text eol=lf
/flatpak/*.json text eol=lf
/flatpak/*.py text eol=lf
/flatpak/*.mjs text eol=lf
/flatpak/*.sh text eol=lf
/scripts/*.sh text eol=lf
/headers.txt text eol=lf

# Preserve upstream bytes, including whitespace in the reviewed source and patch.
/src-tauri/vendor/glib/** -text -whitespace
/src-tauri/vendor/glib-variant-str-iter.patch -text -whitespace
