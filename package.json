{
  "name": "mourn-desktop",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.5.4",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.22.0",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "quasar dev -m spa",
    "dev:spa": "quasar dev -m spa",
    "dev:spa:desktop": "MOURN_TARGET=desktop quasar dev -m spa",
    "build": "node scripts/theme-guard.mjs && vue-tsc --noEmit && quasar build -m spa",
    "build:spa": "vue-tsc --noEmit && quasar build -m spa",
    "build:spa:desktop": "node scripts/theme-guard.mjs && vue-tsc --noEmit && MOURN_TARGET=desktop quasar build -m spa",
    "theme:audit": "node scripts/theme-audit.mjs",
    "theme:guard": "node scripts/theme-guard.mjs",
    "theme:sweep": "node scripts/theme-sweep.mjs",
    "theme:probe": "node scripts/theme-probe.mjs",
    "theme:test": "node --test scripts/theme-tools.check.mjs",
    "dev:ssr": "quasar dev -m ssr",
    "build:ssr": "vue-tsc --noEmit && quasar build -m ssr",
    "serve:ssr": "node dist/ssr/index.js",
    "dev:android": "quasar dev -m capacitor -T android",
    "dev:ios": "quasar dev -m capacitor -T ios",
    "build:android": "quasar build -m capacitor -T android",
    "build:ios": "quasar build -m capacitor -T ios",
    "lint": "eslint -c ./eslint.config.js --cache --cache-location node_modules/.cache/eslint/$MOURN_ESLINT_CACHE_KEY/.eslintcache --cache-strategy content \"./src/**/*.{ts,js,cjs,mjs,vue}\" \"./src-ssr/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:clean": "eslint -c ./eslint.config.js --no-cache \"./src/**/*.{ts,js,cjs,mjs,vue}\" \"./src-ssr/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "preview": "vite preview --outDir dist/spa",
    "test": "vitest run --config scripts/vitest.release.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:release": "node --test tests/glibSecurity.test.mjs tests/releaseScripts.test.mjs tests/packaging.test.mjs tests/linuxdeploy.test.mjs tests/webReleasePolicy.test.mjs tests/licensing.test.mjs tests/deployScripts.test.mjs tests/lintCache.test.mjs tests/releaseWorkflowEnv.test.mjs tests/workflowSecurity.test.mjs tests/releaseComposition.test.mjs tests/releasePublishGuard.test.mjs",
    "flatpak:prepare": "python flatpak/prepare-sources.py",
    "postinstall": "quasar prepare",
    "tauri": "tauri",
    "tauri:inject-pubkey": "node ./scripts/inject_pubkey.js",
    "tauri:build-signed": "node ./scripts/build_collect_signatures.js",
    "tauri:generate-keys": "bash ./scripts/generate_keys.sh"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8",
    "@capacitor/haptics": "^8",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8",
    "@capacitor/status-bar": "^8",
    "@capawesome/capacitor-badge": "^8.0.3",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@hpke/chacha20poly1305": "1.7.1",
    "@hpke/ml-kem": "0.2.1",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@noble/post-quantum": "0.5.2",
    "@quasar/extras": "^1.16.4",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@tresjs/cientos": "^5.3.1",
    "@tresjs/core": "^5.4.1",
    "@tresjs/post-processing": "^3.3.1",
    "axios": "^1.20.0",
    "cap-widget": "0.1.57",
    "dompurify": "^3.4.17",
    "follow-redirects": "^1.16.1",
    "idb-keyval": "^6.2.2",
    "isomorphic-ws": "^5.0.0",
    "libsodium-wrappers": "^0.8.2",
    "marked": "^18.0.9",
    "pinia": "^3.0.1",
    "quasar": "^2.35.2",
    "three": "^0.182.0",
    "ts-mls": "^1.6.2",
    "vanilla-tilt": "^1.8.1",
    "vue": "^3.5.43",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^5.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^3.10.3",
    "@tauri-apps/cli": "^2.10.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^22.20.5",
    "@types/three": "^0.182.0",
    "@types/vanilla-tilt": "^1.6.2",
    "@unocss/preset-uno": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.4.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.11.0",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "3.3.10"
  },
  "overrides": {
    "@tauri-apps/api": "2.11.1",
    "@noble/curves": "2.0.1",
    "@noble/ciphers": "2.1.1",
    "@noble/hashes": "2.0.1",
    "@noble/post-quantum": "0.5.2",
    "@hpke/ml-kem": "0.2.1",
    "js-yaml": "^4.3.2",
    "axios": "^1.20.0",
    "follow-redirects": "^1.16.1",
    "@vue/server-renderer": "^3.5.43",
    "source-map-js": "^1.2.2",
    "compression": "^1.8.2",
    "proxy-addr": "^2.0.8",
    "@quasar/ssl-certificate": "^2.1.0",
    "@quasar/render-ssr-error": "^2.2.6"
  }
}
