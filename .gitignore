# Capacitor build output only. The Android scaffold under src-capacitor/ IS
# tracked (the mobile work lives on main now); only the generated web bundle in
# src-capacitor/www/ is ignored. If src-capacitor/ exists without package.json —
# e.g. leftover www/ build output — Quasar considers capacitor mode installed
# and crashes `quasar prepare` (postinstall) and `quasar build` with
# ENOENT: src-capacitor/package.json. Never commit this build output.
/src-capacitor/www/

# Local flatpak generator venv (see flatpak/README.md)
.venv-gen/
.flatpak-builder/
dist/

# flatpak-builder also leaves `build-dir/` behind (measured 126,870 files / 49 GB
# on the dev box) and its root-owned containerd dirs make `bun run lint` abort
# with EACCES before it lints anything.
build-dir/

# Verification evidence (screenshots, CDP probes, run logs) generated by the theme gates.
# ~47 MB per full pass; keep it out of history.
/artifacts/
