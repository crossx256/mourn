# Frontend PUBLIC build configuration only. All these values ship to the renderer.
# Use local/mock services during development; do not paste backend .env files here.
VITE_API_BASE=http://127.0.0.1:3000
VITE_WS_BASE=http://127.0.0.1:3000
# Optional explicit Vault WebSocket origin (must match the native CSP when packaged).
# VITE_VAULT_WS_BASE=ws://127.0.0.1:3000
# Public Cap endpoint, including its PUBLIC site key. Never include the Cap secret.
# VITE_CAP_API_ENDPOINT=http://127.0.0.1:3001/PUBLIC_SITE_KEY/
# Optional PUBLIC Discord application ID and client-visible Klipy key.
# VITE_DISCORD_RPC_CLIENT_ID=
# VITE_KLIPY_API_KEY=
# Client customization (themes, palettes, effects, frosted panels) is on by
# default in every target. Set this to false only to ship a build without it.
# VITE_CLIENT_THEMES=false
MOURN_ENABLE_UPDATER=false
# Isolated CI/Flatpak builds ignore all project .env files.
# MOURN_ISOLATED_BUILD=1
